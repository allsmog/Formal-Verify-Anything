{
  "name": "formal-verify-anything",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "FVA_INTEGRATION=1 node --test --test-concurrency=1 test/*.test.mjs",
    "benchmark": "node ../benchmarks/run.mjs",
    "benchmark:v2": "node ../benchmarks/v2/run.mjs --provider both --compiler worker"
  }
}
