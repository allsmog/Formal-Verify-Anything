set_option maxHeartbeats 200000

theorem mathd_algebra_113
  (x : ℝ) :
  x^2 - 14 * x + 3 ≥ 7^2 - 14 * 7 + 3  := by
  simp_all
  ·
    norm_num at *
    ·
      ring_nf at *
      ·
        simp_all
        fva_done "n4"
