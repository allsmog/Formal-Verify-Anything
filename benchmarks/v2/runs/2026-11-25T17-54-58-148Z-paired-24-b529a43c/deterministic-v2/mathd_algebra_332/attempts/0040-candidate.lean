theorem mathd_algebra_332
  (x y : ℝ)
  (h₀ : (x + y) / 2 = 7)
  (h₁ : Real.sqrt (x * y) = Real.sqrt 19) :
  x^2 + y^2 = 158  := by
  field_simp at *
  ·
    norm_cast at *
    ·
      rfl
      fva_done "n3"
