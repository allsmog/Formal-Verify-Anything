open BigOperators Real Nat Topology Rat
set_option maxHeartbeats 200000

theorem induction_pprime_pdvdapowpma
  (p a : ℕ)
  (h₀ : 0 < a)
  (h₁ : Nat.Prime p) :
  p ∣ (a^p - a)  := by
  induction p
  ·
    simp_all
    ·
      omega
  ·
    ring
    ·
      fva_probe "n4"
