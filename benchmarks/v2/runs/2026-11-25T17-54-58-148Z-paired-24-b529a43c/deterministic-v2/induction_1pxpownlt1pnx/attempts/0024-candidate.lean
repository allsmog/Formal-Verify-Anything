theorem induction_1pxpownlt1pnx
  (x : ℝ)
  (n : ℕ)
  (h₀ : -1 < x)
  (h₁ : 0 < n) :
  (1 + ↑n*x) ≤ (1 + x)^(n:ℕ)  := by
  norm_cast at *
  ·
    simp_all
    ·
      nlinarith
      fva_done "n2"
